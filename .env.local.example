# ------------------------------------------------------------------
# Firebase クライアントSDK の接続情報
# ------------------------------------------------------------------
# Firebase コンソール > プロジェクトの設定 > 全般 > マイアプリ（ウェブアプリ）
# に表示される firebaseConfig の値をそのまま転記する。
#
# このファイルを `.env.local` という名前でコピーして値を埋めること。
# .env.local は .gitignore 済みなのでコミットされない。
#
# NEXT_PUBLIC_ 接頭辞の変数はブラウザのバンドルに埋め込まれる（＝公開される）。
# これらは秘密情報ではなく、実際のアクセス制御は firestore.rules で行っている。
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
